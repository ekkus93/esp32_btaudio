# Override some defaults so BT stack is enabled and
# Classic BT is enabled
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y 
# Disable BLE to reclaim flash space for classic-only firmware
CONFIG_BT_GOEPC_ENABLED=n
CONFIG_BT_BLE_ENABLED=n
CONFIG_BT_GATTS_ENABLE=n
CONFIG_BT_GATTC_ENABLE=n
CONFIG_BT_BLE_SMP_ENABLE=n
# Disable Wi-Fi and coexistence for Bluetooth-only builds
CONFIG_ESP_WIFI_ENABLED=n
CONFIG_ESP_COEX_ENABLED=n

CONFIG_BT_NIMBLE_ENABLED=n



CONFIG_APP_NO_BLOBS=n

# Increase BTC_TASK stack to prevent overflow during A2DP + pairing sequences
CONFIG_BT_BTC_TASK_STACK_SIZE=8192

# Build-time toggle: when enabled, the audio processor will generate
# synthetic audio instead of reading from an I2S peripheral. Useful for
# development and CI when no hardware source is attached.
CONFIG_AUDIO_USE_SYNTH_SOURCE=y

# Enable audio autostart by default for production use (auto-reconnect workflow)
# When enabled, audio initializes on boot and ESP32 auto-plays I2S audio
# when a previously paired Bluetooth headset reconnects.
CONFIG_AUDIO_AUTOSTART_DEFAULT=y

# Bluetooth full-duplex: HFP Audio Gateway over HCI (CVSD bring-up)
CONFIG_BT_HFP_ENABLE=y
CONFIG_BT_HFP_CLIENT_ENABLE=n
CONFIG_BT_HFP_AG_ENABLE=y
CONFIG_BT_HFP_AUDIO_DATA_PATH_HCI=y
CONFIG_BT_HFP_AUDIO_DATA_PATH_PCM=n
CONFIG_BT_HFP_USE_EXTERNAL_CODEC=n
CONFIG_BT_HFP_WBS_ENABLE=n
CONFIG_BTDM_CTRL_BR_EDR_MAX_SYNC_CONN=1
CONFIG_BTDM_CTRL_BR_EDR_SCO_DATA_PATH_HCI=y
CONFIG_BTDM_CTRL_BR_EDR_SCO_DATA_PATH_PCM=n

# FD-08 dedicated HFP microphone PCM output. These values are fixed for the
# initial CVSD path and are validated against the active playback/NVS pins and
# UART2 ownership at runtime; invalid conflicts fail instead of falling back.
CONFIG_HFP_I2S_PORT=0
CONFIG_HFP_I2S_BCLK_GPIO=32
CONFIG_HFP_I2S_WS_GPIO=33
CONFIG_HFP_I2S_DOUT_GPIO=27
CONFIG_HFP_I2S_SAMPLE_RATE=16000
CONFIG_HFP_I2S_RING_BYTES=4096
CONFIG_HFP_I2S_DMA_DESC_NUM=8
CONFIG_HFP_I2S_DMA_FRAME_NUM=120
CONFIG_HFP_I2S_WRITER_SAMPLES=120
CONFIG_HFP_I2S_TASK_STACK_BYTES=4096
CONFIG_HFP_I2S_TASK_PRIORITY=5
CONFIG_HFP_I2S_WRITE_TIMEOUT_MS=20
CONFIG_HFP_I2S_STOP_TIMEOUT_MS=1000
CONFIG_HFP_I2S_MAX_CONSECUTIVE_WRITE_FAILURES=3
CONFIG_HFP_I2S_UNDERFLOW_DEGRADED_THRESHOLD=20
